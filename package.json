{
  "name": "keel",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:rules": "firebase emulators:exec --only firestore --project keel-rules-check \"node src/scripts/rules-check.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm run test && npm run test:rules",
    "eval:recon": "node src/scripts/goldenset.mjs",
    "eval:build": "node src/scripts/goldenset.mjs --build",
    "eval:whoami": "node src/scripts/goldenset.mjs --whoami",
    "eval:rule": "node src/scripts/goldenset.mjs --eval-rule",
    "eval:llm": "node src/scripts/goldenset.mjs --eval-llm",
    "eval:save-labels": "node src/scripts/goldenset.mjs --save-labels",
    "eval:show-review": "node src/scripts/goldenset.mjs --show-review",
    "eval:lift": "node src/scripts/goldenset.mjs --eval-lift",
    "eval:shadow": "node src/scripts/goldenset.mjs --shadow"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/generative-ai": "^0.24.1",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
